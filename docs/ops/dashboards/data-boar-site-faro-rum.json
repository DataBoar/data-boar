      },
      {
        "id": 5,
        "type": "table",
        "title": "RUM volume by environment",
        "gridPos": {"h": 9, "w": 8, "x": 16, "y": 5},
        "datasource": {"type": "loki", "uid": "grafanacloud-logs"},
        "targets": [{"refId": "A", "expr": "sum by (deployment_environment) (count_over_time({service_name=\"DataBoar Site\"}[$__range]))", "queryType": "instant", "editorMode": "code", "format": "table"}],
        "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
        "options": {"showHeader": true}
      }
