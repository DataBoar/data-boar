make_dirs="/var/lib/databoar 0750 databoar databoar"

do_install() {
	if [ ! -x "${FILESDIR}/staging/usr/lib/data-boar/python3.14t/bin/python3.14t" ]; then
		msg_error "missing embedded interpreter in FILESDIR/staging (ADR-0084)\n"
	fi
	vmkdir usr/lib
	cp -a "${FILESDIR}/staging/usr/lib/data-boar" "${DESTDIR}/usr/lib/data-boar"
	vbin "${FILESDIR}/staging/usr/bin/data-boar"
	vmkdir etc/data-boar
	if [ -f "${FILESDIR}/staging/etc/data-boar/config.example.yaml" ]; then
		vinstall "${FILESDIR}/staging/etc/data-boar/config.example.yaml" 644 etc/data-boar
	fi
	vsv data-boar
}

data-boar-compressed_package() {
	depends="${sourcepkg}>=${version}_${revision}"
	short_desc+=" - compressed connector extra"
	# EXTRAS_MANIFEST packages: py7zr>=1.1.3
	pkg_install() {
		if [ ! -d "${DESTDIR}/usr/lib/data-boar/extras/compressed" ]; then
			msg_error "extras/compressed missing from staging — refuse empty subpackage\n"
		fi
		vmove usr/lib/data-boar/extras/compressed
	}
}

