{
  "schema_version": 1,
  "issue": 1403,
  "adr": "0084",
  "version": "1.8.0-beta",
  "packagers": [
    "deb",
    "rpm",
    "apk",
    "archlinux"
  ],
  "excluded_packagers": [
    "xbps"
  ],
  "layer1": "vendored_pinned_wheelhouse",
  "layer2": "distro_depends_overrides",
  "commercial_protection": "worker_caps_and_pro_prefilter_accel",
  "embedded_interpreter": {
    "channel": "a_native_enterprise",
    "version": "3.14",
    "abi_tag": "cp314t",
    "freethreaded": true,
    "prefix": "/usr/lib/data-boar",
    "python_bin": "/usr/lib/data-boar/python3.14t/bin/python3.14t"
  },
  "subpackages": {
    "data-boar-compressed": {
      "extra": "compressed",
      "packages": [
        "py7zr>=1.1.3"
      ],
      "modules": [
        "py7zr"
      ]
    },
    "data-boar-dataformats": {
      "extra": "dataformats",
      "packages": [
        "pyarrow>=14.0.0",
        "fastavro>=1.9.0",
        "dbfread>=2.0.7"
      ],
      "modules": [
        "pyarrow",
        "fastavro",
        "dbfread"
      ]
    },
    "data-boar-mssql": {
      "extra": "mssql-pymssql",
      "packages": [
        "pymssql>=2.3.0"
      ],
      "modules": [
        "pymssql"
      ]
    },
    "data-boar-nosql": {
      "extra": "nosql",
      "packages": [
        "pymongo>=4.0",
        "redis>=8.1.0"
      ],
      "modules": [
        "pymongo",
        "redis"
      ]
    },
    "data-boar-richmedia": {
      "extra": "richmedia",
      "packages": [
        "mutagen>=1.47.0",
        "pillow-heif>=0.16.0",
        "pytesseract>=0.3.13"
      ],
      "modules": [
        "mutagen",
        "pillow_heif",
        "pytesseract"
      ]
    },
    "data-boar-shares": {
      "extra": "shares",
      "packages": [
        "smbprotocol>=1.2.0",
        "webdavclient3>=0.14.0",
        "requests_ntlm>=1.2.0"
      ],
      "modules": [
        "smbprotocol",
        "webdav3.client",
        "requests_ntlm"
      ]
    }
  }
}
